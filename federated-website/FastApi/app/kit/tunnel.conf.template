# Plant-side tunnel (SITE_NETWORK_PLAN.md §1): Flower 1.25's SuperNode can't present a client
# certificate, so it talks TLS to this local proxy, which connects to the ArqauQuat gateway with
# the plant certificate (secrets/site.crt). Only reachable inside this kit's Compose network.
server {
    listen 9092 ssl;
    http2 on;
    access_log /dev/stdout;

    ssl_certificate      /pki/tunnel.crt;          # trusted by the SuperNode via secrets/local-ca.crt
    ssl_certificate_key  /pki/tunnel.key;
    ssl_protocols        TLSv1.3;
    client_max_body_size 1g;

    location / {
        grpc_pass                    grpcs://${GATEWAY_HOST}:443;
        grpc_ssl_certificate         /pki/site.crt;
        grpc_ssl_certificate_key     /pki/site-tls.key;
        grpc_ssl_trusted_certificate ${GATEWAY_CA_FILE};   # the gateway's public CA (Let's Encrypt)
        grpc_ssl_verify              on;
        grpc_ssl_verify_depth        3;
        grpc_ssl_name                ${GATEWAY_HOST};
        grpc_ssl_server_name         on;
        grpc_ssl_protocols           TLSv1.2 TLSv1.3;
        grpc_read_timeout            900s;
        grpc_send_timeout            900s;
    }
}
