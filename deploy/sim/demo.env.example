# Settings for deploy/sim/demo_reset.sh. Copy to deploy/sim/demo.env (git-ignored) and adjust.
# Nothing secret goes here.

# The stack's data folder (runs, promoted models, lab site data). Use the same value for every
# `docker compose -f deploy/docker-compose.yml ...` command during the demo.
FEDWIND_DATA=$HOME/fedwind-demo-data

# Promoted again by the reset: the models forecasts start from
DEMO_WIND_RUN=wind-fedavg-h72-<run A>
DEMO_SOLAR_RUN=solar-fedavg-h72-<run C>

# Not promoted by the reset: promoted live in the demo (step 9) to show the switch
DEMO_NEWER_WIND_RUN=wind-fedavg-h72-<run B>

# Kept by the reset with their organization, accounts and running simulated agent: example plants
# that are already online when the demo starts (space-separated site ids)
DEMO_KEEP_PLANTS=
