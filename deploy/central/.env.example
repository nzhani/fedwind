# ArqauQuat central server (deploy/central/docker-compose.yml). Copy to deploy/central/.env.
# Both names must point (DNS A record) at this server's public address before certs.sh issue.
WEB_HOST=arqauquat.kz
SITES_HOST=sites.arqauquat.kz
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=

# Random strings: openssl rand -hex 32
POSTGRES_PASSWORD=
GATEWAY_SHARED_SECRET=

# Where runs, promoted models and the GPT-2 cache live on this server
CENTRAL_DATA=./data
# CPU is enough: training happens at the plants
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
OMP_NUM_THREADS=4

ALLOW_REGISTRATION=true
HEARTBEAT_S=60

# Telegram alerts (optional)
BOT_TOKEN=
SUPPORT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Scheduled training: weekly slots in TRAIN_SCHEDULE_TZ, e.g. "wind=SUN 02:00; solar=SUN 03:00"
# (empty: admins start runs by hand). A slot needs TRAIN_MIN_SITES plants that can train: online,
# Flower node registered, and at least TRAIN_MIN_HOURS hours of data in their training store.
TRAIN_SCHEDULE=
TRAIN_SCHEDULE_TZ=Asia/Almaty
TRAIN_MIN_SITES=3
TRAIN_MIN_HOURS=2160
TRAIN_SAMPLE_ABOVE=30
