# Copy to deploy/.env (gitignored) and fill in.

# Local Postgres password for the Compose database. Pick any random value.
POSTGRES_PASSWORD=

# Where runs, models, site data and the HF cache live (default deploy/data)
# FEDWIND_DATA=/big-disk/fedwind-data

# Published ports
WEB_PORT=3000
API_PORT=8001

# Addresses the *browser* uses. On a server, use its host name or IP, e.g.
# PUBLIC_WEB_URL=http://10.1.2.3:3000 and PUBLIC_API_URL=http://10.1.2.3:8001
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8001

# PyTorch build for the Flower image. GPU (driver >= 570): cu128. Older driver: cu126.
# Laptop / no GPU: https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# GPU id per client (compose.gpu.yml). Clients may share a GPU.
GPU_ALMATY=0
GPU_ZHEZKAZGAN=0
GPU_AKTAU=0
GPU_TARAZ=0
GPU_AKTOBE=0

# Uncomment to run the web app without the federation or inference ("not connected").
# FEDERATION_ADDRESS=
# INFERENCE_URL_TEMPLATE=

# Optional: Telegram notifications for feedback
BOT_TOKEN=
SUPPORT_CHAT_ID=
