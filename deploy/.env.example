# Copy to deploy/.env (gitignored) and fill in.

# Local Postgres password for the Compose database. Pick any random value.
POSTGRES_PASSWORD=

# Where runs, models, site data and the HF cache live (default deploy/data)
# FEDWIND_DATA=/big-disk/fedwind-data

# Published ports
WEB_PORT=3000
API_PORT=8001

# Addresses the *browser* uses. On a server, use its host name or IP, e.g.
# PUBLIC_WEB_URL=http://10.1.2.3:3000 and PUBLIC_API_URL=http://10.1.2.3:8001
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8001

# PyTorch build for the Flower image. GPU (driver >= 570): cu128. Older driver: cu126.
# Laptop / no GPU: https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# GPU id per client (compose.gpu.yml). Clients may share a GPU.
GPU_ALMATY=0
GPU_ZHEZKAZGAN=0
GPU_AKTAU=0
GPU_TARAZ=0
GPU_AKTOBE=0
GPU_KONAEV=0
GPU_SHYMKENT=0
GPU_KYZYLORDA=0
GPU_SARAN=0
GPU_TURKISTAN=0

# Uncomment to run the web app without the federation or inference ("not connected").
# FEDERATION_ADDRESS=
# INFERENCE_URL_TEMPLATE=

# Optional: Telegram notifications for feedback
BOT_TOKEN=
SUPPORT_CHAT_ID=

# Accounts. Behind HTTPS keep SESSION_COOKIE_SECURE=true; on plain http://localhost set false,
# or the browser drops the login cookie. First admin: see DEPLOY.md ("Accounts").
SESSION_COOKIE_SECURE=true
ALLOW_REGISTRATION=true
# Random string; Telegram must send it back with every webhook call
TELEGRAM_WEBHOOK_SECRET=

# Plant connection (SITE_NETWORK_PLAN.md M3). token: development (plants use a bearer site key; refused
# with ENV=production). mtls: plants use the client certificate from enrollment, behind the mTLS gateway (M4).
SITE_AUTH_MODE=token
# on: register each plant's Flower SuperNode key at enrollment (needs a SuperLink with TLS and
# --enable-supernode-auth); off: the key is only stored
FLOWER_NODE_AUTH=off
# mtls mode: random string the gateway sends with X-Site-Id / X-Client-Serial
GATEWAY_SHARED_SECRET=
